{
  "manifest_version": 3,
  "name": "Local LinkedIn AI Assistant",
  "version": "0.6.3",
  "description": "Privacy-first LinkedIn reply drafting via a local Ollama server. Nothing leaves your machine.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/defaults.js",
        "src/selectors.js",
        "src/scraper.js",
        "src/prompt.js",
        "src/picker.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "LinkedIn AI Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-unread": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Toggle LinkedIn's Unread filter"
    },
    "next-conversation": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Open the next conversation down"
    },
    "insert-meeting-link": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Paste your meeting link into the composer"
    }
  }
}