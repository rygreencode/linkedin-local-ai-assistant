# Copy to .env and fill in your own values, then run:
#   python3 scripts/apply_env.py
#
# .env and the generated config.local.json are both gitignored. These values
# only seed a setting the first time; once you save anything in the extension's
# popup or options page, your saved value wins and .env is ignored.

# Your booking link — pasted by the "Add meeting link" button and Alt+M.
BOOKING_LINK=

# Optional overrides.
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# USER_NAME=
# USER_COMPANY=
